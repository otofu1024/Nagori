#!/bin/sh
set -eu

fail() { printf 'nagori: %s\n' "$*" >&2; exit 1; }

# Resolve both installation symlinks and file targets using macOS shell tools.
resolve_path() {
    resolved=$1
    while [ -L "$resolved" ]; do
        link=$(readlink "$resolved") || return 1
        case "$link" in
            /*) resolved=$link ;;
            *) resolved=$(dirname "$resolved")/$link ;;
        esac
    done
    if [ -d "$resolved" ]; then
        (CDPATH= cd -P -- "$resolved" && pwd -P)
    else
        parent=$(CDPATH= cd -P -- "$(dirname "$resolved")" && pwd -P) || return 1
        printf '%s/%s\n' "$parent" "$(basename "$resolved")"
    fi
}

case "${1-}" in
    -h|--help) printf 'Usage: nagori [directory | file]\n'; exit 0 ;;
esac
[ "$#" -le 1 ] || fail 'ディレクトリまたはファイルを1つ指定してください。'
[ "$(uname -s)" = Darwin ] || fail 'このコマンドはmacOS用です。'
input=${1:-.}
[ -e "$input" ] || fail "対象が存在しません: $input"
target=$(resolve_path "$input") || fail '対象のパスを解決できません。'
workspace=$(pwd -P)
if [ -d "$target" ]; then
    workspace=$target
elif [ -f "$target" ]; then
    case "$target" in
        "${workspace%/}/"*) ;;
        *) workspace=$(dirname "$target") ;;
    esac
else
    fail 'ディレクトリまたは通常ファイルを指定してください。'
fi
script=$(resolve_path "$0") || fail 'コマンドのパスを解決できません。'
case "$script" in
    */Contents/Resources/cli/nagori)
        app=${script%/Contents/Resources/cli/nagori}
        ;;
    *)
        project=$(dirname "$(dirname "$script")")
        app=$project/src-tauri/target/release/bundle/macos/Nagori.app
        if [ ! -d "$app" ]; then
            app=$HOME/Applications/Nagori.app
            [ -d "$app" ] || app=/Applications/Nagori.app
        fi
        ;;
esac
[ -d "$app" ] || fail 'Nagori.appがありません。先にMac用アプリをビルドまたはインストールしてください。'
if [ -d "$target" ]; then
    exec /usr/bin/open -a "$app" "$workspace"
else
    exec /usr/bin/open -a "$app" "$workspace" "$target"
fi
