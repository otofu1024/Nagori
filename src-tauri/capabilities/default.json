{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local Nagori window: event listeners and explicit file selection only.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "dialog:allow-open",
    "core:menu:default",
    "dialog:allow-message",
    "core:resources:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
